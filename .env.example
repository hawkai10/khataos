# KhataOS environment — copy to .env and fill in your credentials.
# The server auto-loads .env at startup (shell env vars take precedence).

# ── DeepSeek AI Copilot ─────────────────────────────────────────
# Model name for DeepSeek V4 Flash (OpenAI-compatible chat completions).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=15000
# AI_DISABLED=1   # force the deterministic rule engine (no external calls)

# ── Decentro Connected Banking (real bank data) ─────────────────
DECENTRO_CLIENT_ID=
DECENTRO_CLIENT_SECRET=
DECENTRO_MODULE_SECRET=
DECENTRO_PROVIDER_SECRET=

# ── GSTN / GSP (real GSTR-2B + e-invoice) ──────────────────────
GSTN_GSTIN=
GSTN_USERNAME=
GSTN_APP_KEY=
GSTN_CLIENT_ID=
GSTN_CLIENT_SECRET=

# ── TallyPrime ─────────────────────────────────────────────────
# Cloud-only: Tally data arrives as XML exports uploaded in the app
# (Tally > Import Tally XML). No connection env vars required.

# ── Database ────────────────────────────────────────────────────
# KHATAOS_DB_ENGINE=sqlite|pglite|postgres
# KHATAOS_DATABASE_URL=postgres://user:pass@host:5432/khataos
# PORT=8080

# â”€â”€ Security: rate-limit client keying â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Login/OTP rate limits key on the raw socket IP by default. Set to 1 ONLY
# behind a proxy that overwrites or strips client-supplied X-Forwarded-For
# (nginx `proxy_set_header X-Forwarded-For $remote_addr`, or an edge rule that
# removes the header). Proxies that merely append (ALB, CloudFront) leave the
# attacker-controlled value first and are NOT safe to trust.
# KHATAOS_TRUST_PROXY=0

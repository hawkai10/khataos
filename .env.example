# KhataOS environment — copy to .env and fill in your credentials.
# The server auto-loads .env at startup (shell env vars take precedence).

# ── DeepSeek AI Copilot ─────────────────────────────────────────
# Model name for DeepSeek V4 Flash (OpenAI-compatible chat completions).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=15000
# AI_DISABLED=1   # force the deterministic rule engine (no external calls)

# ── Decentro Connected Banking (real bank data) ─────────────────
DECENTRO_CLIENT_ID=
DECENTRO_CLIENT_SECRET=
DECENTRO_MODULE_SECRET=
DECENTRO_PROVIDER_SECRET=

# ── GSTN / GSP (real GSTR-2B + e-invoice) ──────────────────────
GSTN_GSTIN=
GSTN_USERNAME=
GSTN_APP_KEY=
GSTN_CLIENT_ID=
GSTN_CLIENT_SECRET=

# ── TallyPrime ─────────────────────────────────────────────────
# Cloud-only: Tally data arrives as XML exports uploaded in the app
# (Tally > Import Tally XML). No connection env vars required.

# ── Database ────────────────────────────────────────────────────
# KHATAOS_DB_ENGINE=sqlite|pglite|postgres
# KHATAOS_DATABASE_URL=postgres://user:pass@host:5432/khataos
# PORT=8080

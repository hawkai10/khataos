# Dev-runnable image for the dependency-free API + SPA.
# The production variant swaps the SQLite adapter for PostgreSQL/ClickHouse
# via the same API surface (see docs/architecture.md).
FROM node:22-alpine
WORKDIR /app
COPY server/package.json ./server/
COPY server/src ./server/src
COPY web ./web
COPY docs ./docs
ENV PORT=8080
EXPOSE 8080
CMD ["node", "server/src/server.js"]
